{
  "contract": "shengbentong-api",
  "version": "v2.1",
  "frozen": true,
  "date": "2026-08-25",
  "supersedes": "api_contract_v1.json",
  "schema_version": 2,
  "base_url": "http://<PC局域网IP>:8000",
  "enums": {
    "question_type": [
      "single_choice",
      "multiple_choice",
      "judgment",
      "fill_blank"
    ],
    "judge_answer": [
      "T",
      "F"
    ],
    "import_status": [
      "success",
      "partial",
      "failed"
    ]
  },
  "endpoints": {
    "GET /api/health": {
      "resp": {
        "status": "ok",
        "app": "shengbentong",
        "schema_version": 2,
        "stats": {
          "subjects": "int",
          "chapters": "int",
          "questions": "int"
        }
      }
    },
    "POST /api/bind": {
      "desc": "App首次绑定探测(无鉴权)",
      "resp": {
        "status": "bound",
        "app": "shengbentong",
        "schema_version": 2
      }
    },
    "GET /api/sync/all": {
      "resp": {
        "schema_version": 2,
        "data_version": "string 题库数据版本，导入后更新；App据此判断是否有更新",
        "exported_at": "ISO8601",
        "subjects": [
          {
            "id": 1,
            "name": "科目名",
            "chapters": [
              {
                "id": 11,
                "title": "章节名",
                "order_num": 1,
                "knowledge_md": "原始Markdown|null",
                "questions": [
                  {
                    "$ref": "#/schemas/question"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    "GET /api/sync/chapters/{subject_id}": "同all内chapter数组(含questions)",
    "GET /api/sync/questions/{chapter_id}": {
      "resp": {
        "chapter_id": 11,
        "title": "...",
        "questions": [
          {
            "$ref": "#/schemas/question"
          }
        ]
      }
    },
    "GET /static/images/{name}": {
      "desc": "v2新增：题目图像静态服务（png/jpg/jpeg/gif/webp）",
      "resp": "image/* 二进制流，200；不存在404",
      "note": "name为导入时sha1摘要文件名，URL已urlencode，App直接使用question.image字段值"
    },
    "POST /api/sync/progress": {
      "body": {
        "records": [
          {
            "question_id": 1,
            "is_correct": true,
            "answered_at": "ISO8601可选",
            "in_wrong_book": false,
            "in_favorites": false
          }
        ]
      },
      "resp": {
        "accepted": 128,
        "duplicate_ignored": 3
      },
      "idempotent_key": "(question_id, answered_at)"
    },
    "POST /api/admin/import": {
      "body": {
        "path": "服务器本地题库根目录或单个练习题.md路径"
      },
      "dir_resp": {
        "log_id": 7,
        "ok": true,
        "status": "success|partial|failed",
        "report": "见数据集文档·导入报告"
      },
      "file_resp_ok": {
        "log_id": 8,
        "ok": true,
        "report": {
          "subject": "...",
          "chapter": "...",
          "imported": 15
        }
      },
      "file_resp_fatal": {
        "http": 400,
        "detail": {
          "message": "...",
          "errors": [
            {
              "code": "E122",
              "line": 66,
              "msg": "..."
            }
          ]
        }
      },
      "v2_note": "【图】相对路径在导入时拷入 /static/images/（sha1命名防撞名、同名覆盖可更新）；缺图告警W323不阻断"
    },
    "GET /api/admin/import/{log_id}": "历史报告查询",
    "GET /api/admin/stats": {
      "subjects": [
        {
          "name": "...",
          "chapters": 10,
          "questions": 386,
          "by_type": {}
        }
      ]
    },
    "GET /api/admin/template?kind=md|prompt": "text/plain 官方模板",
    "DELETE /api/admin/subject/{subject_id}": {
      "desc": "v2.1新增：删除指定科目（级联删除其章节/题目/答题记录），并清理不再被任何题目引用的静态图片文件",
      "resp": {
        "deleted": {
          "chapters": "int",
          "questions": "int",
          "images": "int"
        }
      },
      "errors": {
        "404": "科目不存在"
      },
      "notes": [
        "不可恢复：答题记录一并删除（源md在test-bank可重导题目，答题记录无法恢复）",
        "共用图片保护：仅删除删除后全库无引用的图片文件",
        "App端调用后需自行清理本地数据（本地为replaceAll缓存，重同步亦会同步删除结果）"
      ]
    },
    "GET /api/admin/lan-ip": {
      "desc": "v2.1新增：返回服务端局域网IPv4（非回环），供管理台生成连接二维码/显示IP",
      "resp": {
        "ip": "192.168.1.124"
      }
    },
    "GET /": {
      "desc": "v2.1新增：302重定向到管理台 /api/admin/page（浏览器输 localhost:8000 直达）"
    }
  },
  "schemas": {
    "question": {
      "id": "int",
      "type": "single_choice|multiple_choice|judgment|fill_blank",
      "number": "int 原始题号",
      "global_seq": "int 章内重排连续序号",
      "material": "str|null 【材料】块",
      "image": "str|null v2新增：【图】静态URL(/static/images/…)。App同步时下载到本地缓存并把该字段改写为本地绝对路径，离线渲染；单图下载失败置null不阻断同步",
      "stem": "str 完形填空形态可为空串(配合material)",
      "options": [
        "内容A",
        "内容B",
        "内容C",
        "内容D"
      ],
      "answer": "single:'B' | multiple:'ABD' | judgment:'T'|'F' | blank:原文多空用｜分隔",
      "accepts": "[[每空候选答案]] | null(fill_blank专用)",
      "explanation": "str 可为空串"
    }
  },
  "compat_rules": [
    "schema_version大于App支持值(App当前支持≤2) → App提示协议版本不兼容，需升级App",
    "schema_version大于App本地已同步值 → App清空本地库重新全量同步(v1→v2由本地DB onUpgrade补列无损升级)",
    "字段只增不改名；删除字段须升contract大版本",
    "data_version与本地不同 → App提示有更新可重同步"
  ]
}
